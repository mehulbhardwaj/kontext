#!/bin/sh

# .kontext/actions/install-hooks
# Symlinks the hooks to .git/hooks

HOOK_DIR=".git/hooks"
KONTEXT_HOOK=".kontext/actions/pre-commit"

if [ ! -d "$HOOK_DIR" ]; then
    echo "❌ .git directory not found. Are you in the root of the repo?"
    exit 1
fi

echo "🔗 Linking $KONTEXT_HOOK to $HOOK_DIR/pre-commit..."
ln -sf "../../$KONTEXT_HOOK" "$HOOK_DIR/pre-commit"
chmod +x "$KONTEXT_HOOK"

echo "✅ Hook installed."
