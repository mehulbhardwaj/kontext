#!/bin/sh

# .kontext/actions/pre-commit
# 1. suggest: Ensures intent is documented (creates ADRs).
# 2. sync: Ensures IDE rules (.cursorrules) are updated with that intent.

# If not interactive, skip interactive suggestion but still try to sync if possible?
# syncing is safe to run always.

if [ ! -t 1 ]; then
    echo "🔍 [Kontext] Non-interactive mode. Skipping Suggest."
else
    echo "🔍 [Kontext] Checking environment..."
    echo "🤖 [Kontext Agent] Waking up..."
    # 1. Run Suggestion Engine
    npm run --silent dev -- suggest < /dev/tty > /dev/tty || true
fi

# 2. Run Sync (Broadcaster)
# This updates .cursorrules based on whatever state exists now (including new ADRs)
echo "📡 [Kontext Broadcaster] Syncing context to IDE rules..."
npm run --silent dev -- sync || true

# 3. Add any changes made by Sync to the commit
# Sync modifies .cursorrules. If we don't stage it, it won't be in this commit.
git add .cursorrules .windsurfrules 2>/dev/null || true

exit 0
